# Copy to .env (same folder) and fill in. Never commit .env.

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel: the token from the
# "docker run ... --token ..." install command.
CLOUDFLARE_TUNNEL_TOKEN=

# Shared by the node and the portal. Generate: openssl rand -hex 32
VV_OPERATOR_TOKEN=

# Your own creation code, for communities you create yourself (optional).
# Generate: openssl rand -hex 24
VV_PROVISIONING_TOKEN=

PORTAL_PUBLIC_URL=https://servidor.vamovirar.app
# Gets an email for each new request, and the replies from approved people.
PORTAL_ADMIN_EMAIL=
# Password for https://servidor.vamovirar.app/admin (12+ characters).
PORTAL_ADMIN_PASSWORD=
# Signs the admin login cookie. Generate: openssl rand -hex 32
PORTAL_SESSION_SECRET=

# Sender and SMTP server. With Resend (domain vamovirar.app verified there):
#   PORTAL_MAIL_FROM=Vamo Virar <servidor@vamovirar.app>
#   PORTAL_SMTP_URL=smtps://resend:YOUR_API_KEY@smtp.resend.com:465
# Any SMTP server works; URL-encode special characters in the password.
PORTAL_MAIL_FROM=Vamo Virar <servidor@vamovirar.app>
PORTAL_SMTP_URL=

# What the approve form starts with (each can be changed per request).
PORTAL_DEFAULT_MAX_COMMUNITIES=1
PORTAL_DEFAULT_MAX_LOG_MB=256
PORTAL_DEFAULT_MAX_FILES_MB=512
