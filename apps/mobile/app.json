{
  "expo": {
    "name": "Vamo Virar",
    "slug": "vamo-virar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.bessa.vamovirar",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FD0000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "me.bessa.vamovirar",
      "permissions": [
        "READ_CALENDAR",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "O Vamo Virar lê só os horários em que você está ocupada(o), para mostrar se você pode ir a um evento. Nada da sua agenda sai do celular."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Vamo Virar usa sua localização só quando você pede, uma vez, para marcar onde você está agora. Ela fica no celular.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 290,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E0E12"
          }
        }
      ]
    ],
    "scheme": "vamovirar",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "googleClientIdIos": "",
      "googleClientIdAndroid": "",
      "googleClientIdWeb": "",
      "microsoftClientId": "",
      "eas": {
        "projectId": "643e5bf0-8533-4789-a016-d5a3491ebfe7"
      }
    },
    "owner": "hugobessa"
  }
}
