  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:web": "expo export --platform web --output-dir dist-web",
    "e2e:web": "node e2e/web.e2e.mjs",
    "eas-build-post-install": "cd ../.. && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist-storybook",
    "store-screenshots": "npm run build-storybook && node scripts/store-screenshots.mjs",
    "brand-assets": "npm run build-storybook && node scripts/brand-assets.mjs",
    "landing": "vite --config landing/vite.config.ts",
    "build:landing": "vite build --config landing/vite.config.ts",
    "preview:landing": "vite preview --config landing/vite.config.ts --outDir ../dist-landing"
