{
  "name": "@vamo-virar/matching",
  "version": "0.0.0",
  "private": true,
  "description": "On-device matching: availability from calendars (and, in Phase 7, location). Nothing here leaves the device.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "fast-check": "4.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
